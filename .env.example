# Default: fictional sample universe. Never label these records as exchange data.
DATA_MODE=demo
# Server-only credentials, needed only for DATA_MODE=supabase
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Local pipeline only. Groq is disabled until this key is configured.
GROQ_API_KEY=
# Optional OpenAI-compatible extraction provider overrides
EXTRACTOR_A_URL=
EXTRACTOR_A_KEY=
EXTRACTOR_A_MODEL=openai/gpt-oss-20b
EXTRACTOR_B_URL=
EXTRACTOR_B_KEY=
EXTRACTOR_B_MODEL=openai/gpt-oss-120b
# Authenticates administrative API requests; never NEXT_PUBLIC_
ADMIN_TOKEN=
